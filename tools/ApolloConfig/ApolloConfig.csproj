<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\apollo.ico</ApplicationIcon>
    <AssemblyName>ApolloConfig</AssemblyName>
    <AssemblyTitle>R3D PLAY</AssemblyTitle>
    <Product>R3D PLAY</Product>
    <Description>R3D PLAY – configuração e biblioteca de jogos</Description>
    <Company>Braga Digital Studio</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ui\**\*" Exclude="ui\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
